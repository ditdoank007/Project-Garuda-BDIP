using System.DirectoryServices.Protocols;
using System.Net;
using BDIP.Infrastructure.Ldap;
using Microsoft.Extensions.Options;

namespace BDIP.Infrastructure.Dashboard;

public class LdapDashboardRepository : ILdapDashboardRepository
{
    private readonly LdapOptions _options;

    public LdapDashboardRepository(IOptions<LdapOptions> options)
    {
        _options = options.Value;
    }

    public Task<int> CountUsersAsync()
    {
        return CountAsync(
            $"ou=People,{_options.BaseDn}",
            "(objectClass=inetOrgPerson)"
        );
    }

    public async Task<int> CountGroupsAsync()
    {
        var groupOfNames = await CountAsync(
            $"ou=Groups,{_options.BaseDn}",
            "(objectClass=groupOfNames)"
        );

        var posixGroups = await CountAsync(
            $"ou=Groups,{_options.BaseDn}",
            "(objectClass=posixGroup)"
        );

        return groupOfNames + posixGroups;
    }

    public Task<int> CountUnitsAsync()
    {
        return CountAsync(
            $"ou=Units,{_options.BaseDn}",
            "(objectClass=organizationalUnit)"
        );
    }

    public Task<int> CountApplicationsAsync()
    {
        return CountAsync(
            $"ou=Applications,{_options.BaseDn}",
            "(objectClass=organizationalUnit)"
        );
    }

    public async Task<bool> IsHealthyAsync()
    {
        try
        {
            using var connection = CreateConnection();
            connection.Bind();
            return true;
        }
        catch
        {
            return false;
        }
    }

    private Task<int> CountAsync(string baseDn, string ldapFilter)
    {
        using var connection = CreateConnection();

        var request = new SearchRequest(
            baseDn,
            ldapFilter,
            SearchScope.Subtree,
            "dn"
        );

        var response = (SearchResponse)connection.SendRequest(request);

        return Task.FromResult(response.Entries.Count);
    }

    private LdapConnection CreateConnection()
    {
        var identifier = new LdapDirectoryIdentifier(
            _options.Host,
            _options.Port
        );

        var connection = new LdapConnection(identifier)
        {
            AuthType = AuthType.Basic
        };

        connection.SessionOptions.ProtocolVersion = 3;

        if (_options.UseSsl)
        {
            connection.SessionOptions.SecureSocketLayer = true;
        }

        connection.Credential = new NetworkCredential(
            _options.BindDn,
            _options.Password
        );

        return connection;
    }
}
