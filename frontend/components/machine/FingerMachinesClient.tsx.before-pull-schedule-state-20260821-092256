"use client";

import { useEffect, useState } from "react";
import { Plus, Pencil, Trash2 } from "lucide-react";

import type {
  FingerMachine,
  FingerMachineFormData,
} from "@/types/finger-machine";

import type { Location } from "@/types/location";

import {
  createFingerMachine,
  updateFingerMachine,
  deleteFingerMachine,
  getFingerMachineGlobalPolicy,
  updateFingerMachineGlobalPolicy,
  getFingerMachineRuntimeStatus,
} from "@/lib/api/finger-machines";

import FingerMachineDialog from "./FingerMachineDialog";

interface FingerMachinesClientProps {
  machines: FingerMachine[];
  locations: Location[];
}

type DialogMode = "create" | "edit";

const defaultForm: FingerMachineFormData = {
  code: "",
  name: "",
  ipAddress: "",
  port: 4370,
  locationId: null,
  serialNumber: "",
  deviceName: "",
  isActive: true,
};

function machineToFormData(
  machine: FingerMachine,
): FingerMachineFormData {
  return {
    code: machine.code,
    name: machine.name,
    ipAddress: machine.ipAddress,
    port: machine.port,
    locationId: machine.locationId,
    serialNumber: machine.serialNumber,
    deviceName: machine.deviceName,
    isActive: machine.isActive,
  };
}

export default function FingerMachinesClient({
  machines,
  locations,
}: FingerMachinesClientProps) {
  const [dialogOpen, setDialogOpen] =
    useState(false);

  const [dialogMode, setDialogMode] =
    useState<DialogMode>("create");

  const [saving, setSaving] =
    useState(false);

  const [editingMachine, setEditingMachine] =
    useState<FingerMachine | null>(null);

  const [formData, setFormData] =
    useState<FingerMachineFormData>(
      defaultForm,
    );

  const [clearEnabled, setClearEnabled] =
    useState(true);

  const [clearTime, setClearTime] =
    useState("04:00");

  const [clearLoading, setClearLoading] =
    useState(true);

  const [clearSaving, setClearSaving] =
    useState(false);

  const [clearMessage, setClearMessage] =
    useState("");

  const [runtimeStatus, setRuntimeStatus] =
    useState<any[]>([]);

  const [runtimeLoading, setRuntimeLoading] =
    useState(true);

  async function loadClearPolicy() {
    try {
      setClearLoading(true);

      const response =
        await getFingerMachineGlobalPolicy();

      const policy =
        response?.data;

      if (!policy) {
        throw new Error(
          "Global CLEAR policy tidak ditemukan.",
        );
      }

      setClearEnabled(
        policy.clearEnabled === true,
      );

      setClearTime(
        String(
          policy.clearTime ?? "04:00",
        ).slice(0, 5),
      );
    } catch (error) {
      console.error(
        "Failed to load CLEAR policy:",
        error,
      );

      setClearMessage(
        "Gagal membaca konfigurasi CLEAR.",
      );
    } finally {
      setClearLoading(false);
    }
  }

  async function handleSaveClearPolicy() {
    setClearSaving(true);
    setClearMessage("");

    try {
      await updateFingerMachineGlobalPolicy({
        clearEnabled,
        clearTime: `${clearTime}:00`,
      });

      setClearMessage(
        "Konfigurasi CLEAR berhasil disimpan.",
      );
    } catch (error) {
      console.error(
        "Failed to save CLEAR policy:",
        error,
      );

      setClearMessage(
        "Gagal menyimpan konfigurasi CLEAR.",
      );
    } finally {
      setClearSaving(false);
    }
  }

  async function loadRuntimeStatus() {
    try {
      setRuntimeLoading(true);

      const response =
        await getFingerMachineRuntimeStatus();

      setRuntimeStatus(
        response?.data ?? [],
      );

    } catch (error) {
      console.error(
        "Failed loading runtime status:",
        error,
      );
    } finally {
      setRuntimeLoading(false);
    }
  }

  useEffect(() => {
    void loadClearPolicy();
    void loadRuntimeStatus();

    const timer =
      setInterval(
        () => {
          void loadRuntimeStatus();
        },
        300000,
      );

    return () =>
      clearInterval(timer);

  }, []);

  function getRuntime(machineCode: string) {
    return runtimeStatus.find(
      (item) =>
        item.machineCode === machineCode,
    );
  }


  function handleAddMachine() {
    setDialogMode("create");
    setEditingMachine(null);
    setFormData({
      ...defaultForm,
    });
    setDialogOpen(true);
  }

  function handleEditMachine(
    machine: FingerMachine,
  ) {
    setDialogMode("edit");
    setEditingMachine(machine);
    setFormData(
      machineToFormData(machine),
    );
    setDialogOpen(true);
  }

  async function handleCreateMachine() {
    setSaving(true);

    try {
      await createFingerMachine(
        formData,
      );

      window.location.reload();
    } finally {
      setSaving(false);
    }
  }

  async function handleUpdateMachine() {
    if (!editingMachine) {
      return;
    }

    setSaving(true);

    try {
      await updateFingerMachine(
        editingMachine.code,
        formData,
      );

      window.location.reload();
    } finally {
      setSaving(false);
    }
  }

  async function handleDialogSave() {
    if (dialogMode === "create") {
      await handleCreateMachine();
    } else {
      await handleUpdateMachine();
    }
  }

  async function handleDeleteMachine(
    machine: FingerMachine,
  ) {
    const confirmed = window.confirm(
      `Hapus mesin "${machine.name}" (${machine.code})?\n\nData policy mesin juga akan ikut dihapus.`,
    );

    if (!confirmed) {
      return;
    }

    setSaving(true);

    try {
      await deleteFingerMachine(machine.code);

      window.location.reload();
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="space-y-6">

      <div className="flex items-center justify-between">

        <div>
          <h1 className="text-3xl font-bold">
            Mesin Finger
          </h1>

          <p className="text-slate-500">
            Manage dan monitoring mesin finger.
          </p>
        </div>

        <button
          onClick={handleAddMachine}
          className="flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-800"
        >
          <Plus size={18} />
          Tambah Mesin
        </button>

      </div>

      <div className="rounded-xl border bg-white p-6 shadow-sm">

        <p className="text-sm text-slate-500">
          Total Mesin
        </p>

        <p className="mt-2 text-4xl font-bold">
          {machines.length}
        </p>

      </div>

      <div className="overflow-hidden rounded-xl border bg-white shadow-sm">

        <div className="border-b px-6 py-4">
          <h2 className="font-semibold">
            Daftar Mesin Finger
          </h2>
        </div>

        <div className="overflow-x-auto">

          <table className="w-full text-sm">

            <thead className="bg-slate-50 text-left">

              <tr>

                <th className="px-6 py-3 font-semibold">
                  Code
                </th>

                <th className="px-6 py-3 font-semibold">
                  Nama
                </th>

                <th className="px-6 py-3 font-semibold">
                  IP Address
                </th>

                <th className="px-6 py-3 font-semibold">
                  Port
                </th>

                <th className="px-6 py-3 font-semibold">
                  Location
                </th>

                <th className="px-6 py-3 font-semibold">
                  ONLINE
                </th>

                <th className="px-6 py-3 font-semibold">
                  LAST SEEN
                </th>

                <th className="px-6 py-3 font-semibold">
                  Status
                </th>

                <th className="px-6 py-3 text-right font-semibold">
                  Action
                </th>

              </tr>

            </thead>

            <tbody className="divide-y">

              {machines.map(
                (machine) => {
                  const runtime =
                    getRuntime(machine.code);

                  return (
                  <tr
                    key={machine.id}
                    className="hover:bg-slate-50"
                  >

                    <td className="px-6 py-4 font-medium">
                      {machine.code}
                    </td>

                    <td className="px-6 py-4">
                      {machine.name}
                    </td>

                    <td className="px-6 py-4">
                      {machine.ipAddress}
                    </td>

                    <td className="px-6 py-4">
                      {machine.port}
                    </td>

                    <td className="px-6 py-4">
                      {machine.locationName || "-"}
                    </td>

                    <td className="px-6 py-4">

                      <span
                        className={
                          runtime?.isOnline
                            ? "rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-700"
                            : "rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-red-700"
                        }
                      >
                        {runtime?.isOnline
                          ? "ONLINE"
                          : "OFFLINE"}
                      </span>

                    </td>

                    <td className="px-6 py-4 text-sm text-slate-600">
                      {runtime?.lastSeenAt
                        ? new Date(
                            runtime.lastSeenAt,
                          ).toLocaleString(
                            "id-ID",
                          )
                        : "-"}
                    </td>

                    <td className="px-6 py-4">

                      <span
                        className={
                          machine.isActive
                            ? "rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-700"
                            : "rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600"
                        }
                      >
                        {machine.isActive
                          ? "ACTIVE"
                          : "INACTIVE"}
                      </span>

                    </td>

                    <td className="px-6 py-4 text-right">

                      <div className="flex justify-end gap-2">

                        <button
                          onClick={() =>
                            handleEditMachine(
                              machine,
                            )
                          }
                          className="inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-sm hover:bg-slate-50"
                        >
                          <Pencil size={16} />
                          Edit
                        </button>

                        <button
                          onClick={() =>
                            handleDeleteMachine(
                              machine,
                            )
                          }
                          disabled={saving}
                          className="inline-flex items-center gap-2 rounded-lg border border-red-200 px-3 py-2 text-sm text-red-600 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50"
                        >
                          <Trash2 size={16} />
                          Hapus
                        </button>

                      </div>

                    </td>

                  </tr>
                );
              },
            )}

              {machines.length === 0 && (
                <tr>

                  <td
                    colSpan={9}
                    className="px-6 py-10 text-center text-slate-500"
                  >
                    Belum ada mesin finger.
                  </td>

                </tr>
              )}

            </tbody>

          </table>

        </div>

      </div>

      <div className="rounded-xl border bg-white p-6 shadow-sm">

        <div className="flex items-start justify-between gap-6">

          <div>
            <h2 className="text-lg font-semibold">
              CLEAR DATA MESIN FINGER
            </h2>

            <p className="mt-1 text-sm text-slate-500">
              Hapus data attendance dari seluruh mesin
              finger secara otomatis sesuai jadwal global.
            </p>
          </div>

          <span
            className={
              clearEnabled
                ? "rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700"
                : "rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"
            }
          >
            {clearEnabled
              ? "ACTIVE"
              : "DISABLED"}
          </span>

        </div>

        <div className="mt-6 grid gap-6 md:grid-cols-2">

          <div>
            <label
              htmlFor="clear-time"
              className="block text-sm font-medium text-slate-700"
            >
              Waktu Clear
            </label>

            <input
              id="clear-time"
              type="time"
              value={clearTime}
              onChange={(event) =>
                setClearTime(event.target.value)
              }
              disabled={
                clearLoading ||
                clearSaving
              }
              className="mt-2 w-full rounded-lg border px-3 py-2 outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200"
            />

            <p className="mt-1 text-xs text-slate-500">
              Berlaku untuk seluruh mesin finger.
            </p>
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-700">
              Status CLEAR
            </label>

            <button
              type="button"
              onClick={() =>
                setClearEnabled(
                  !clearEnabled,
                )
              }
              disabled={
                clearLoading ||
                clearSaving
              }
              className={
                clearEnabled
                  ? "mt-2 flex w-full items-center justify-between rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-left"
                  : "mt-2 flex w-full items-center justify-between rounded-lg border bg-slate-50 px-4 py-3 text-left"
              }
            >
              <span>
                <span
                  className={
                    clearEnabled
                      ? "block font-semibold text-green-700"
                      : "block font-semibold text-slate-600"
                  }
                >
                  {clearEnabled
                    ? "ACTIVE"
                    : "DISABLED"}
                </span>

                <span className="block text-xs text-slate-500">
                  {clearEnabled
                    ? "CLEAR otomatis aktif."
                    : "CLEAR otomatis tidak dijalankan."}
                </span>
              </span>

              <span
                className={
                  clearEnabled
                    ? "text-green-600"
                    : "text-slate-400"
                }
              >
                ●
              </span>
            </button>
          </div>

        </div>

        <div className="mt-6 flex items-center justify-between gap-4">

          <div className="text-sm">
            {clearMessage && (
              <span
                className={
                  clearMessage.includes(
                    "berhasil",
                  )
                    ? "text-green-600"
                    : "text-red-600"
                }
              >
                {clearMessage}
              </span>
            )}
          </div>

          <button
            type="button"
            onClick={
              handleSaveClearPolicy
            }
            disabled={
              clearLoading ||
              clearSaving ||
              !clearTime
            }
            className="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {clearSaving
              ? "Menyimpan..."
              : "Simpan Perubahan"}
          </button>

        </div>

      </div>


      <FingerMachineDialog
        open={dialogOpen}
        onOpenChange={setDialogOpen}
        title={
          dialogMode === "create"
            ? "Tambah Mesin Finger"
            : "Edit Mesin Finger"
        }
        machine={formData}
        locations={locations}
        onChange={setFormData}
        onSave={handleDialogSave}
        saving={saving}
        saveLabel={
          dialogMode === "create"
            ? "Tambah Mesin"
            : "Simpan Perubahan"
        }
        readOnlyCode={
          dialogMode === "edit"
        }
      />

    </div>
  );
}
