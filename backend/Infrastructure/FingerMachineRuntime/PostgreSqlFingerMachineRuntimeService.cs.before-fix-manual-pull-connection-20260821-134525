    public async Task<object> ManualPullAsync(
        string machineCode)
    {
        var machineCommand = _connection.CreateCommand();

        machineCommand.CommandText = """
            SELECT
                code,
                ip_address,
                port
            FROM public.finger_machines
            WHERE code = @code
            LIMIT 1;
        """;

        machineCommand.Parameters.AddWithValue(
            "code",
            machineCode);


        await using var reader =
            await machineCommand.ExecuteReaderAsync();


        if (!await reader.ReadAsync())
        {
            throw new Exception(
                "Finger machine not found.");
        }


        var ipAddress =
            reader["ip_address"].ToString();

        var port =
            Convert.ToInt32(reader["port"]);


        using var client =
            new HttpClient();


        var payload = new
        {
            ip = ipAddress,
            port = port
        };


        var response =
            await client.PostAsJsonAsync(
                "http://192.168.100.129:8090/manual-pull",
                payload);


        var result =
            await response.Content
                .ReadFromJsonAsync<object>();


        return result
            ?? new
            {
                success = false,
                message = "Empty response"
            };
    }

